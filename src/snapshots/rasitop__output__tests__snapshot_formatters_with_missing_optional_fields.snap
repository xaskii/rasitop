    csv: "timestamp,cpu_power_w,gpu_power_w,combined_power_w,e_busy_ratio,p_busy_ratio,e_freq_ghz,p_freq_ghz,battery_percent\n,1.00,0.50,1.50,0.0000,0.0000,0.00,0.00,",
    json: "{\"timestamp\":null,\"cpu_power_w\":1.00,\"gpu_power_w\":0.50,\"combined_power_w\":1.50,\"e_busy_ratio\":null,\"p_busy_ratio\":null,\"e_freq_ghz\":null,\"p_freq_ghz\":null,\"battery_percent\":null}",
}
